# Variaveis lidas pelo docker compose (copie para .env na raiz, ao lado do docker-compose.yml).
# As variaveis do backend ficam em backend/.env (veja backend/.env.example).

# Hosts publicos. Frontend e API precisam compartilhar um dominio pai para o cookie de sessao
FRONTEND_HOST=app.seudominio.com
API_HOST=api.app.seudominio.com

# Rede Docker externa onde o Traefik (reverse proxy) enxerga os containers
PROXY_NETWORK=dokploy-network
