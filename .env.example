# Opcional. O compose sobe com os valores padrao abaixo sem este arquivo.
# Copie para .env na raiz so se alguma porta ja estiver em uso ou se o app estiver publicado
# num dominio, em vez de localhost.

FRONTEND_PORT=3000
BACKEND_PORT=4000
GATEWAY_PORT=54321
DB_PORT=54322

# Onde o app responde de fato. Sem isto o compose assume localhost nas portas acima, o que vale
# para a maquina de quem desenvolve mas nao para um servidor com dominio proprio
# FRONTEND_ORIGIN=https://app.seudominio.com
# APP_BASE_URL=https://app.seudominio.com
# NEXT_PUBLIC_API_URL=https://api.app.seudominio.com
# COOKIE_DOMAIN=seudominio.com
# COOKIE_SECRET=troque-este-valor-em-qualquer-ambiente-publico

# A conexao com o Supabase hospedado fica em backend/.env, junto das chaves. E a presenca de
# SUPABASE_URL ali que faz o ./compose.sh deixar de subir o banco local.
