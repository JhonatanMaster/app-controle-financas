# Variaveis lidas pelo docker compose (copie para .env na raiz)

# Portas publicadas no host, apenas em 127.0.0.1. Troque se ja estiverem em uso no servidor
BACKEND_HOST_PORT=4100
FRONTEND_HOST_PORT=3100

# URL publica da API, embutida no build do frontend
NEXT_PUBLIC_API_URL=https://api.seudominio.com
