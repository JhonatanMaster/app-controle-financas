# Opcional. O compose sobe com os valores padrao abaixo sem este arquivo.
# Aqui fica a topologia, onde o app responde. Credencial nao entra neste arquivo, mora em
# backend/.env, inclusive a conexao com o Supabase e o COOKIE_SECRET.

# Portas no host, usadas quando o app nao esta publicado num dominio. Mude se alguma ja estiver
# em uso no servidor
FRONTEND_PORT=3000
BACKEND_PORT=4000
GATEWAY_PORT=54321
DB_PORT=54322

# Publicar num dominio, atraves de um Traefik que ja exista no servidor. Definindo FRONTEND_HOST,
# o ./compose.sh troca as portas acima por rotas no proxy, com certificado automatico. Os dois
# nomes precisam apontar para o servidor no DNS antes da primeira subida
# FRONTEND_HOST=compras.seudominio.com
# API_HOST=api.compras.seudominio.com
# PROXY_NETWORK=dokploy-network
# CERT_RESOLVER=letsencrypt

# Dominio pai comum ao app e a API. Em subdominios do mesmo dominio o cookie de sessao funciona
# sem isto, entao so preencha se precisar compartilhar a sessao com outro subdominio
# COOKIE_DOMAIN=seudominio.com

# Para publicar num dominio sem o Traefik, com um proxy proprio na frente das portas acima
# FRONTEND_ORIGIN=https://compras.seudominio.com
# APP_BASE_URL=https://compras.seudominio.com
# NEXT_PUBLIC_API_URL=https://api.compras.seudominio.com
