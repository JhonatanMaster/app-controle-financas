# Opcional. O docker compose sobe com os valores padrao abaixo sem este arquivo.
# Copie para .env na raiz so se alguma porta ja estiver em uso ou para testar e-mail de verdade.

FRONTEND_PORT=3000
BACKEND_PORT=4000
GATEWAY_PORT=54321
DB_PORT=54322

# Com chave, convites e redefinicao de senha saem por e-mail de fato
RESEND_API_KEY=
RESEND_FROM_EMAIL=Controle Finanças <no-reply@seudominio.com>
