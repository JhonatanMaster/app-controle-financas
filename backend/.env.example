# Copie para backend/.env. Serve para rodar o backend fora do Docker, com npm run dev, e tambem
# e de onde o compose tira a conexao com o Supabase.
#
# Os valores abaixo apontam para o Supabase local que o compose sobe, entao nada precisa mudar para
# avaliar o projeto. Trocando SUPABASE_URL e as chaves pelas de um projeto em supabase.com, o
# ./compose.sh passa a subir so backend e frontend, ligados nesse projeto.

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
COOKIE_SECRET=segredo-de-cookie-do-ambiente-local
# Vazio em localhost. Em producao, o dominio pai comum ao frontend e a API
COOKIE_DOMAIN=

# Gateway do Supabase local publicado pelo docker compose. As chaves valem so para esse
# ambiente e sao as mesmas definidas no docker-compose.yml
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsImlhdCI6MTc5MDU1MzYwMCwiZXhwIjo0MTAyNDQ0ODAwLCJyb2xlIjoiYW5vbiJ9.ZTedFH81aZ2a3O_wDNK2DbFkLIZe9AHLPJvSRq7TF3Q
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsImlhdCI6MTc5MDU1MzYwMCwiZXhwIjo0MTAyNDQ0ODAwLCJyb2xlIjoic2VydmljZV9yb2xlIn0.uSnDvSoYEL1Dp-R86otp552LfOtlLOqfL2pUbCWg-O4

# Opcional em localhost. Sem chave, os e-mails de convite e senha aparecem no log do backend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Controle Finanças <no-reply@localhost>
