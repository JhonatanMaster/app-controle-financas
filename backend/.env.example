# Usado so para rodar o backend fora do Docker, com npm run dev. Copie para backend/.env.
# Os valores ja apontam para o Supabase local que o docker compose sobe, nada precisa mudar.

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
COOKIE_SECRET=segredo-de-cookie-do-ambiente-local
# Vazio em localhost. Em producao, o dominio pai comum ao frontend e a API
COOKIE_DOMAIN=

# Gateway do Supabase local publicado pelo docker compose. As chaves valem so para esse
# ambiente e sao as mesmas definidas no docker-compose.yml
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsImlhdCI6MTc5MDU1MzYwMCwiZXhwIjo0MTAyNDQ0ODAwLCJyb2xlIjoiYW5vbiJ9.ZTedFH81aZ2a3O_wDNK2DbFkLIZe9AHLPJvSRq7TF3Q
