PORT=4000
FRONTEND_ORIGIN=https://compras.seudominio.com
COOKIE_SECRET=change-me-to-a-long-random-string
# Em producao use .compras.seudominio.com para o cookie valer em compras.* e api.compras.*
COOKIE_DOMAIN=.compras.seudominio.com

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Pegue no Supabase Dashboard em Project Settings, API Keys, service_role. Nunca exponha ao frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Chave do Resend com permissao de envio, restrita ao dominio seudominio.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Controle Financas <no-reply@seudominio.com>
APP_BASE_URL=https://compras.seudominio.com
