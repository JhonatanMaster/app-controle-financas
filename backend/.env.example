PORT=4000
FRONTEND_ORIGIN=https://app.seudominio.com
COOKIE_SECRET=change-me-to-a-long-random-string
# Dominio pai que abrange frontend e API, para o cookie valer nos dois. Vazio em localhost
COOKIE_DOMAIN=.app.seudominio.com

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Pegue no Supabase Dashboard em Project Settings, API Keys, service_role. Nunca exponha ao frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Chave do Resend com permissao de envio, restrita ao seu dominio verificado
RESEND_API_KEY=
RESEND_FROM_EMAIL=Controle Financas <no-reply@seudominio.com>
APP_BASE_URL=https://app.seudominio.com
